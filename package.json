{
  "name": "vibe-flow",
  "version": "1.0.0",
  "description": "A Cursor-like coding editor with free Claude & GPT AI integration",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "desktop:dev": "turbo dev --filter=desktop",
    "web:dev": "turbo dev --filter=web",
    "agent:dev": "turbo dev --filter=agent",
    "desktop:build": "turbo build --filter=desktop",
    "web:build": "turbo build --filter=web",
    "test": "turbo test"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.12",
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.12",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1"
  }
}
